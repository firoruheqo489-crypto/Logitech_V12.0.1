{
  "name": "mold-gantt-v3",
  "version": "11.2.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/free-dev-ports.mjs && pnpm run dev:raw",
    "dev:raw": "concurrently -n vite,api -c blue,green \"vite --host\" \"pnpm run dev:api\"",
    "dev:stable": "pnpm run dev",
    "dev:restart": "pnpm run dev",
    "dev:only": "vite --host",
    "dev:api": "cross-env DEV_API=1 PORT=3001 tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/write-release-manifest.mjs",
    "build:release": "node scripts/write-release-manifest.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:restart": "pm2 restart mold-gantt-v3 --update-env",
    "pm2:logs": "pm2 logs mold-gantt-v3",
    "pm2:save": "pm2 save",
    "pm2:startup:global": "pm2 startup systemd -u root --hp /root && pm2 save",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "rollback:create": "node scripts/rollback-manager.mjs create",
    "rollback:list": "node scripts/rollback-manager.mjs list",
    "rollback:restore": "node scripts/rollback-manager.mjs restore",
    "rollback:prune": "node scripts/rollback-manager.mjs prune",
    "git-backup:create": "node scripts/git-backup-manager.mjs create",
    "git-backup:list": "node scripts/git-backup-manager.mjs list",
    "git-backup:restore": "node scripts/git-backup-manager.mjs restore",
    "git-backup:prune": "node scripts/git-backup-manager.mjs prune",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate:legacy-assets": "tsx scripts/migrate-legacy-supabase-assets.ts",
    "verify:oss-api": "node scripts/verify-oss-http-smoke.mjs",
    "verify:oss-api:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-local-oss-smoke.ps1",
    "format": "prettier --write ."
  },
