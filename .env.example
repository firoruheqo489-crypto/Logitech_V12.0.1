# ═══════════════════════════════════════════════════════════════════════════════
# Supabase V3 — Database Connection
# ═══════════════════════════════════════════════════════════════════════════════
#
# Replace with your Supabase V3 instance connection string.
# Format: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
#
DATABASE_URL=postgresql://postgres:your-password@your-supabase-host:5432/postgres

# ═══════════════════════════════════════════════════════════════════════════════
# Optional — Vite Client Variables
# ═══════════════════════════════════════════════════════════════════════════════
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Required - Write API Auth
API_SECRET_KEY=replace-with-a-random-write-api-key
# Optional - friendlier admin password for browser write-session login.
# If omitted, the browser login prompt accepts API_SECRET_KEY.
# DASHBOARD_WRITE_PASSWORD=replace-with-an-admin-write-password

# Required - Aliyun OSS Upload/Delete
# Deployment uploads `.env`, not `.env.local`, so OSS settings must exist here.
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=your-bucket-name
ALIYUN_OSS_ACCESS_KEY_ID=your-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=your-access-key-secret
